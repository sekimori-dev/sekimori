{
  "agent": "claude-code",
  "policies": "policies.cedar",
  "upstreams": [
    {
      "name": "fs",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "classify": {
        "trusted": ["list_*", "get_file_info", "directory_tree", "list_allowed_directories"],
        "untrusted": ["read_*", "search_files"],
        "sinks": ["write_*", "edit_*", "move_*", "create_*"]
      }
    },
    {
      "name": "payroll",
      "command": "node",
      "args": ["../packages/gateway/example/payroll-server.ts"],
      "classify": { "trusted": ["list_*"], "sinks": ["update_*"] }
    },
    {
      "name": "notion",
      "url": "https://mcp.notion.com/mcp",
      "classify": {
        "untrusted": ["notion-search", "notion-fetch", "notion-get-*", "notion-query-*", "notion-list-*"],
        "sinks": ["notion-create-*", "notion-update-*", "notion-move-*", "notion-duplicate-*", "notion-delete-*", "notion-set-*", "notion-restore-*"]
      }
    }
  ],
  "limits": { "timeoutMs": 30000 },
  "approvals": { "port": 4747, "ttlMinutes": 15 }
}
