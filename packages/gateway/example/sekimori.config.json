{
  "agent": "claude-code",
  "policies": "policies.cedar",
  "upstreams": [
    {
      "name": "fs",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "classify": {
        "trusted": ["list_*", "get_file_info", "directory_tree", "list_allowed_directories"],
        "untrusted": ["read_*", "search_files"],
        "sinks": ["write_*", "edit_*", "move_*", "create_*"]
      }
    },
    {
      "name": "jira",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "classify": {
        "trusted": ["atlassianUserInfo", "getAccessibleAtlassianResources", "getVisibleJiraProjects"],
        "untrusted": ["get*", "search*", "fetch", "lookup*"],
        "sinks": ["create*", "edit*", "update*", "add*", "transition*"]
      }
    }
  ],
  "limits": { "timeoutMs": 30000 },
  "approvals": { "port": 4747, "ttlMinutes": 15 }
}
